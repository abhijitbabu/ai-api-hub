# Server
APP_NAME=AI API Hub
APP_BASE_URL=http://127.0.0.1:8000
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite locally; use Postgres in production)
DATABASE_URL=sqlite:///./data/hub.db

# Provider keys — keep these on the server only
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: default timeout for provider calls (seconds)
PROVIDER_TIMEOUT=60
MAX_UPLOAD_MB=5
